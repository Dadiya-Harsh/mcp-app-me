# Copy to .env for local dev. No secrets in this file.

# Where content.json, the case study .md files and /api/medium come from
PORTFOLIO_URL=https://www.harshdadiya.in

# How long fetched content is cached in memory (seconds)
CONTENT_TTL_SECONDS=300

# Local dev and tests: read content.json from disk instead of the website
# CONTENT_FIXTURE_PATH=tests/fixtures/content.json

# Host / Origin allow lists (comma separated). "host:*" means any port.
# On Vercel the deployment's own hosts (VERCEL_URL, VERCEL_BRANCH_URL,
# VERCEL_PROJECT_PRODUCTION_URL) are added automatically, so previews work.
ALLOWED_HOSTS=mcp.harshdadiya.in,localhost:*,127.0.0.1:*
ALLOWED_ORIGINS=http://localhost:*

LOG_LEVEL=INFO

# Used from M6 (availability). Leave unset until then.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# CALENDAR_ID=primary
# WORK_HOURS=10:00-18:00
# OWNER_TIMEZONE=Asia/Kolkata
